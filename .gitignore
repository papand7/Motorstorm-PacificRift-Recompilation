# MotorStorm: Pacific Rift native recompilation -- project repository ignore rules.
#
# The workspace root also holds user-supplied game data, 50+ GB of generated
# output, the ps3recomp checkout (its own repository) and 100+ agent worktrees.
# Everything at the top level is therefore ignored by default and only the
# reviewed project paths below are re-included. Add a new top-level path here
# deliberately, never with `git add -f`.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/AGENTS.md
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_LICENSES.md
!/docs/
!/tools/
!/port/
# The Vulkan port the launcher's source snapshot packs (source_bundles.js); source and unit tests only.
!/port-vkgame/
# The PC launcher (source only; its node_modules, builds and the player's files are ignored below).
!/launcher/
node_modules/
/launcher/electron/dist/
/launcher/electron/out/
# The developer's install root (MotorStorm\: downloaded toolchains, the unpacked source snapshot with lifted
# code, the player's game files, exes, captures). Never tracked.
/launcher/dev/
# Scratch folders a test run can leave beside the service (e.g. a mangled temp-root name).
/launcher/electron/service/Users*/
/launcher/pipeline/__pycache__/

# generated/ is private by default (decrypted ELF, lifted PPU/SPU source,
# overlays, frames, HDD images, logs, runs). Only per-task Markdown reports and
# small analysis scripts are visible, and `tools/audit_public.py --staged
# --private-reports` still has to pass them (no disassembly, hex dumps, binary
# content or local user paths). See docs/AGENT_WORKFLOW.md.
!/generated/
/generated/*
!/generated/analysis/
/generated/analysis/*
!/generated/analysis/*/
/generated/analysis/*/*
!/generated/analysis/*/*.md
!/generated/analysis/*/tools/
/generated/analysis/*/tools/*
!/generated/analysis/*/tools/*.py
# Snapshots of docs/STATUS.md taken before a task; the live file is tracked.
/generated/analysis/*/*.before_*.md

# Per-title port: lifted output and SPU lifts stay local.
/port/recompiled/
/port/spu/
/port/src/recomp/

# User-supplied game, firmware and decryption material (anywhere).
*.iso
*.ISO
*.sfo
*.SFO
*.self
*.SELF
*.elf
*.ELF
*.prx
*.PRX
*.sprx
*.SPRX
*.psarc
*.PSARC
*.pkg
*.PKG
*.rap
*.RAP
*.rif
*.RIF
*.edat
*.EDAT
*.keys
*.klic
*.pup
*.PUP
EBOOT.BIN
**/dev_flash/
**/dev_hdd0/

# Lifted or recompiled game/firmware code.
**/generated_spu/
**/recompiled/
**/spu_lifted/
**/fw_spu/

# Build output and binaries.
/build/
build-*/
out/
dist/
release/
*.bin
*.BIN
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.so
*.dylib
*.dmg
*.zip
*.7z
*.rar

# Captures, dumps, traces and performance data.
*.log
*.etl
*.dmp
*.mdmp
*.rsxi
*.bmp
*.png
*.jpg
*.jpeg
*.dds
*.tga
*.wav
*.mp3
*.ogg
*.flac
*.at3
*.bik
*.pcap
ps3_critical_path*.txt
performance.json

# Shader caches and compiled shaders.
*.cso
*.dxil
*.dxbc
*.pso
shadercache/
shader_cache/

# Secrets and local configuration (never commit; see SECURITY.md).
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.cookie
cookies.txt
*credentials*
*secret*
!SECURITY.md
local.toml
*.local.toml
rpcn*.cfg

# Tooling and IDE state.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.vs/
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
CMakeFiles/
CMakeCache.txt
.cache/
.claude/
.codecodedrift/

# The launcher icons (project artwork from icon.svg); tools/audit_public.py exempts exactly these two.
!/launcher/electron/assets/icon.png
!/launcher/electron/assets/icon.ico

