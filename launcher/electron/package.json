{
  "name": "motorstorm-launcher",
  "productName": "MotorStorm Pacific Rift",
  "version": "0.2.0",
  "description": "MotorStorm: Pacific Rift on PC (native recompilation): builds the game from your own disc, its settings, HD textures",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "bundles": "node source_bundles.js --with-pcmenu",
    "service": "node service/cli.js",
    "dist": "node source_bundles.js --with-pcmenu && electron-builder --win portable",
    "dist:public": "electron-builder --win portable --config electron-builder.public.json"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.papand7.motorstorm.launcher",
    "productName": "MotorStorm Pacific Rift",
    "directories": {
      "output": "../out"
    },
    "files": [
      "main.js",
      "settings.js",
      "preload.js",
      "service/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "service/*.py"
    ],
    "extraResources": [
      {
        "from": "../../generated/analysis/vksync/tools/texpack.py",
        "to": "tools/texpack.py"
      },
      {
        "from": "../../tools/texcollect",
        "to": "tools/texcollect",
        "filter": [
          "*.py"
        ]
      },
      {
        "from": "../game.json",
        "to": "game.json"
      },
      {
        "from": "../toolchain.json",
        "to": "toolchain.json"
      },
      {
        "from": "../../build/launcher-source",
        "to": "source",
        "filter": [
          "motorstorm-source.tar",
          "SOURCE.json"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "MotorStormPacificRift.exe",
      "unpackDirName": "MotorStormPacificRift"
    }
  }
}
