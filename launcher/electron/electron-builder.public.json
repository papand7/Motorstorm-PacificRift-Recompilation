{
  "appId": "io.github.papand7.motorstorm.launcher",
  "productName": "MotorStorm Pacific Rift",
  "directories": {
    "output": "../../build/release-0.2.0",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "settings.js",
    "bench.js",
    "updates.js",
    "preload.js",
    "service/**/*",
    "ui/**/*",
    "assets/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "service/*.py"
  ],
  "extraResources": [
    {
      "from": "../game.json",
      "to": "game.json"
    },
    {
      "from": "../toolchain.json",
      "to": "toolchain.json"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      "portable"
    ]
  },
  "portable": {
    "artifactName": "MotorStormPacificRift.exe",
    "unpackDirName": "MotorStormPacificRift"
  }
}
